# Anthropic API key used to call Claude. Required.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Host/port where DFHack's remote interface is listening.
DFHACK_HOST=localhost
DFHACK_PORT=5000

# Timeout (ms) for DFHack calls. Some calls (e.g. full briefings) return
# large payloads, so this overrides the DFHack client's own shorter default.
#DFHACK_TIMEOUT=30000

# Port the companion app's own HTTP server listens on.
COMPANION_PORT=3000

# How often (ms) the companion app polls fortress state.
POLL_INTERVAL_MS=60000

# Claude "effort" level: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# Directory for local data (history.json, state dumps, etc).
DATA_DIR=./data

# NOTE: the Claude model is fixed at "claude-opus-5" per project spec and is
# NOT configurable via an environment variable.
